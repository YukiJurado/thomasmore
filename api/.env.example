# Copy to api/.env for local use. Never commit credentials.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
CACHE_TTL_MS=30000
MAIL_RETRY_MS=10000
SMTP_TIMEOUT_MS=5000
# Configure one provider. Resend uses HTTPS and works on hosts that block SMTP ports.
# MAIL_FROM=Campus Events <events@your-verified-domain.example>
# RESEND_API_KEY=replace-with-your-private-key
# Or use an SMTP provider / local mail testing server:
# SMTP_URL=smtp://username:password@smtp.example.com:587
# MAIL_FROM=events@your-verified-domain.example
# Use an absolute DB_STORAGE on a mounted persistent disk for durable hosting.
# Free Render local files are lost on restart/redeploy; free deployment is a demo only.
